# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Admin IDs (separados por coma, ej: 6602534530,987654321)
ADMIN_TELEGRAM_IDS=

# --- Motor de IA: Elige UNA de las 3 opciones ---

# Opción 1: Google Gemini (Recomendado gratuito en la nube: rápido, preciso, sin usar CPU)
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opción 2: Ollama Local (Gratis, local, sin conexión externa)
IS_LOCAL_IA=false
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_URL=http://localhost:11434/v1

# Opción 3: OpenCode Go / OpenAI compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=kimi-k2.6

# --- Persistencia y Almacenamiento ---
DB_PATH=data/db.sqlite3
EXCEL_PATH=data/tickets.xlsx
IMAGES_DIR=data/images
