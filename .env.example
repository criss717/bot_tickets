# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Admin IDs (separados por coma, ej: 6602534530,987654321)
ADMIN_TELEGRAM_IDS=

# --- Motor de IA: Elige UNA de las 3 opciones ---

# Opción 1: Google Gemini (Recomendado en servidor: rápido, gratuito, 0% CPU local)
USE_GEMINI=true
GEMINI_API_KEY=
# Opcional: varias API keys separadas por coma para ampliar la cuota gratuita diaria
# GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.5-flash-lite

# Opción 2: Ollama Local (Gratis, local, sin conexión externa; dejar false en Proxmox CT sin GPU)
IS_LOCAL_IA=false
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_URL=http://localhost:11434/v1

# Opción 3: OpenCode Go / OpenAI compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=kimi-k2.6

# --- Persistencia y Almacenamiento ---
DB_PATH=data/db.sqlite3
# En Docker + Samba se recomienda guardar Excel y fotos en export/ (compartido solo lectura)
EXCEL_PATH=export/tickets.xlsx
IMAGES_DIR=export/fotos
